+/// Combine split stdout/stderr with bounded backpressure for the sole consumer.
+/// Unlike broadcast, queued startup and burst output cannot be overwritten.
+pub fn combine_output_receivers_lossless(
+    mut stdout_rx: mpsc::Receiver<Vec<u8>>,
+    mut stderr_rx: mpsc::Receiver<Vec<u8>>,
+) -> mpsc::Receiver<Vec<u8>> {
+    let (combined_tx, combined_rx) = mpsc::channel(64);
+    tokio::spawn(async move {
+        let mut stdout_open = true;
+        let mut stderr_open = true;
+        loop {
+            tokio::select! {
+                stdout = stdout_rx.recv(), if stdout_open => match stdout {
+                    Some(chunk) => {
+                        if combined_tx.send(chunk).await.is_err() { break; }
+                    }
+                    None => stdout_open = false,
+                },
+                stderr = stderr_rx.recv(), if stderr_open => match stderr {
+                    Some(chunk) => {
+                        if combined_tx.send(chunk).await.is_err() { break; }
+                    }
+                    None => stderr_open = false,
+                },
+                else => break,
+            }
+        }
+    });
+    combined_rx
+}
