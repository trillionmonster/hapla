{
  "name": "hapla-web",
  "main": "index.ts",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start --web",
    "web": "expo start --web",
    "web:lan": "cross-env EXPO_PACKAGER_HOSTNAME=0.0.0.0 expo start --web --host lan",
    "test": "vitest",
    "build": "node ../../scripts/export-web.cjs",
    "typecheck": "tsc --noEmit",
    "generate-theme": "tsx sources/theme.gen.ts",
    "start:dev": "cross-env APP_ENV=development expo start --web",
    "start:preview": "cross-env APP_ENV=preview expo start --web",
    "start:production": "cross-env APP_ENV=production expo start --web",
    "web:test": "cross-env APP_ENV=development expo start --web --non-interactive"
  },
