# Copy to .env.selfhost and replace this value before starting a deployment.
HAPLA_MASTER_SECRET=replace-with-at-least-32-random-characters

# Leave empty to serve /files through the same Web origin.
PUBLIC_URL=

# Browser URL used after optional GitHub OAuth callbacks.
HAPLA_WEBAPP_URL=http://localhost:12345

# Optional global Web entry password (scrypt hash, never the plaintext password).
# Generate with: node scripts/hash-site-access-password.cjs < /path/to/password.txt
# Use single quotes around a configured hash so Compose preserves its $ separators.
HAPLA_ACCESS_PASSWORD_HASH=

# Web listener. Use 127.0.0.1 instead of 0.0.0.0 for local-only access.
HAPLA_BIND_ADDRESS=0.0.0.0
HAPLA_PORT=12345

# Optional image tags. Named one-click instances choose their own tags automatically.
HAPLA_SERVER_IMAGE=hapla-server:lite
HAPLA_WEB_IMAGE=hapla-web:lite

# Optional ASR relay. Set an address reachable from the server container.
# Leave empty when no ASR service is configured.
HAPLA_ASR_URL=
# Optional HTTPS dictation page for browsers using a local HTTP Hapla entry.
# This is a public build-time value; never put a credential in it.
HAPLA_ASR_PAGE_URL=

# Optional external file service; used only with deploy/hapla-cloud-files.override.yml.
# HAPLA_R2_CACHE_URL=https://files.example.com
