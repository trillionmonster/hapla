{
    "name": "hapla",
    "private": true,
    "scripts": {
        "cli": "pnpm --filter hapla cli",
        "build": "pnpm --filter @hapla/wire build && pnpm --filter hapla build && pnpm --filter hapla-server build && pnpm --filter hapla-web typecheck",
        "test": "pnpm test:selfhost && pnpm test:patches && pnpm --filter @hapla/wire test && pnpm --filter hapla test && pnpm --filter hapla-server test && pnpm --filter hapla-web test --run",
        "test:patches": "node --test patches/*.test.cjs",
        "check:boundaries": "node ./scripts/check-source-boundaries.cjs && node ./scripts/check-project-isolation.cjs && node ./scripts/check-lightweight-architecture.cjs",
        "check:codex-protocol": "node ./scripts/check-codex-protocol.cjs",
        "check": "pnpm check:docs && pnpm check:boundaries && pnpm check:codex-protocol && pnpm build",
        "release": "node ./scripts/release.cjs",
        "web": "pnpm --filter hapla-web web",
        "web:serve": "node ./scripts/serve-web.cjs",
        "server": "pnpm --filter hapla-server standalone serve",
        "web:build": "pnpm --filter @hapla/wire build && pnpm --filter hapla-web build && node ./scripts/check-web-bundle.cjs",
        "web:smoke": "node ./scripts/acceptance/web-smoke.mjs",
        "selfhost:check": "node ./scripts/selfhost.cjs check",
        "selfhost:up": "node ./scripts/selfhost.cjs up",
        "selfhost:down": "node ./scripts/selfhost.cjs down",
        "postinstall": "node ./scripts/postinstall.cjs",
        "env:new": "tsx environments/environments.ts new",
        "env:list": "tsx environments/environments.ts list",
        "env:use": "tsx environments/environments.ts use",
        "env:remove": "tsx environments/environments.ts remove",
        "env:current": "tsx environments/environments.ts current",
        "env:server": "tsx environments/environments.ts run server",
        "env:web": "tsx environments/environments.ts run web",
        "env:cli": "tsx environments/environments.ts run cli",
        "env:seed": "tsx environments/environments.ts seed",
        "env:up": "tsx environments/environments.ts up",
        "env:up:authenticated": "pnpm env:up --template authenticated-empty",
        "env:down": "tsx environments/environments.ts down",
        "check:docs": "node ./scripts/check-docs.cjs",
        "selfhost:setup": "node ./scripts/selfhost.cjs configure",
        "selfhost:status": "node ./scripts/selfhost.cjs status",
        "selfhost:logs": "node ./scripts/selfhost.cjs logs",
        "test:selfhost": "node --test scripts/tests/selfhost.test.cjs scripts/tests/coding-dev.test.cjs"
    },
    "workspaces": {
        "packages": [
            "packages/hapla-web",
            "packages/hapla-cli",
            "packages/hapla-server",
            "packages/hapla-wire"
        ]
    },
    "pnpm": {
        "overrides": {
            "@babel/core@7": "7.29.6",
            "@hono/node-server": "2.0.12",
            "@xmldom/xmldom": "0.8.13",
            "ajv": "8.20.0",
            "body-parser": "2.3.0",
            "brace-expansion@1": "1.1.17",
            "brace-expansion@5": "5.0.9",
            "defu": "6.1.7",
            "dompurify": "3.4.12",
            "effect": "3.22.1",
            "engine.io": "6.6.9",
            "engine.io-client": "6.6.6",
            "fast-uri": "3.1.4",
            "fast-xml-parser": "4.5.7",
            "follow-redirects": "1.16.0",
            "form-data": "4.0.6",
            "hono": "4.12.33",
            "ip-address": "10.4.0",
            "js-yaml@3": "3.15.0",
            "js-yaml@4": "4.3.0",
            "lodash": "4.18.1",
            "lodash-es": "4.18.1",
            "minimatch@3": "3.1.4",
            "node-forge": "1.4.0",
            "path-to-regexp": "8.4.2",
            "picomatch@2": "2.3.2",
            "picomatch@4": "4.0.5",
            "postcss": "8.5.25",
            "prismjs": "1.30.0",
            "privacy-kit>vite-tsconfig-paths": "-",
            "qs": "6.15.3",
            "rollup": "4.62.4",
            "shell-quote": "1.10.0",
            "socket.io-parser": "4.2.7",
            "uuid@7": "11.1.1",
            "whatwg-url": "14.2.0",
            "parse-path": "7.0.3",
            "@types/parse-path": "7.0.3",
            "ws@7": "7.5.11",
            "ws@8": "8.21.1",
            "yaml": "2.9.0"
        },
        "allowedDeprecatedVersions": {
            "@ungap/structured-clone": "1.3.0",
            "basic-ftp": "5.1.0",
            "glob": "7.2.3",
            "inflight": "1.0.6",
            "rimraf": "3.0.2",
            "tsconfck": "3.1.6",
            "uuid": "7.0.3"
        },
        "onlyBuiltDependencies": [
            "@prisma/client",
            "@prisma/engines",
            "esbuild",
            "node-pty",
            "prisma",
            "sharp"
        ]
    },
    "packageManager": "pnpm@10.11.0",
    "license": "MIT",
    "engines": {
        "node": ">=22"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/trillionmonster/hapla.git"
    },
    "bugs": {
        "url": "https://github.com/trillionmonster/hapla/issues"
    },
    "homepage": "https://github.com/trillionmonster/hapla#readme",
    "description": "Web-first workspace for Claude Code and Codex"
}
