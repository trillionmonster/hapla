[Unit]
Description=Local Qwen3-ASR streaming transcription and Silero VAD
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/hapla/integrations/local-asr
ExecStart=%h/hapla/.runtime/local-asr/.venv/bin/python %h/hapla/integrations/local-asr/server.py
Environment=ASR_MODEL=%h/hapla/.runtime/local-asr/model
Environment=ASR_HOST=127.0.0.1
Environment=ASR_PORT=8765
Environment=HF_HUB_OFFLINE=1
Environment=TRANSFORMERS_OFFLINE=1
Environment=HF_HUB_DISABLE_TELEMETRY=1
Environment=DO_NOT_TRACK=1
Environment=OMP_NUM_THREADS=4
Environment=VLLM_WORKER_MULTIPROC_METHOD=spawn
Restart=on-failure
RestartSec=10
TimeoutStartSec=600
TimeoutStopSec=45

[Install]
WantedBy=default.target
