{
  "name": "hapla-r2-download-gateway",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.mjs && python3 -m unittest discover -s test -p 'test_*.py'",
    "typecheck": "npm run types && tsc --noEmit",
    "build": "wrangler deploy --dry-run --outdir dist",
    "dev": "wrangler dev",
    "types": "node -e \"require('node:fs').mkdirSync('.wrangler/types', { recursive: true })\" && wrangler types .wrangler/types/env.d.ts --strict-vars=false"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "wrangler": "4.132.0"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/trillionmonster/hapla.git",
    "directory": "integrations/r2-download-gateway"
  },
  "bugs": {
    "url": "https://github.com/trillionmonster/hapla/issues"
  },
  "homepage": "https://github.com/trillionmonster/hapla#readme"
}
